msgctxt "6cecc95853c5490eb455b93cee869531"
msgid "དེ་ཡང་ ལྟེ་བ་␣འི་ རྩ་ ལ་␣ས་ རྩ་ གསུམ་ བྱུང་ །"
msgstr "From the channel of the navel three channels formed."

msgctxt "3a960e344899480cbd50b5aa968b2879"
msgid "དེ་ལས་ རྩ་ སུམ་ཅུ་རྩ་གཉིས་ བྱུང་ །"
msgstr "From these three channels, thirty-two channels occur."

msgctxt "4e1307a38bc947598b69d95cd4a11966"
msgid "དེ་ལས་ ཞག་ རེ་རེ་ ལ་རྩ་ ཉིས་ བརྒྱ་ ཉིས་ བརྒྱ་ འཕེལ་བ་ འབྱུང་ ངོ་ །"
msgstr "From these channels, two hundred channels arise each day."

msgctxt "d39ee5553ea14fcb993b493310f44962"
msgid "དེ་ལས་ ལུས་ ཀྱི་ འཁོར་ལོ་ བཞི་ ཆགས་པ་␣འོ །"
msgstr "From these channels, four chakras of the body are formed."

msgctxt "7ab2fa07b7224a47907fddb359119a56"
msgid ""
"དེས་ན་ གདོད་མ་ ནས་ ལུས་ གྲུབ་པ་␣འི་ ཀུན་རྫོབ་ བྱང་ཆུབ་ སེམས་ དང་ རླུང་ "
"འདྲེས་པ་␣འི་ ཐིག་ལེ་ གནས་པ་␣ས །"
msgstr ""
"Therefore because of the existence of the primordial fictional bodhicitta of"
" the formed body and the vital essence mixed with loong,"

msgctxt "11a20836461143599305c731d0cc7eac"
msgid "འཁོར་ལོ་ བཞི་ ན་ སེམས་ ཀྱི་ རྒྱལ་པོ་ དེ་དེ་␣ར་ བརྟེན་ ནས་ གནས་པ་␣འོ །"
msgstr "“the King of mind” exists relying on four chakras."

msgctxt "c76daca37ba54bd2899c5cc4e8700190"
msgid "དེ་␣འི་ ཕྱིར་ ལུས་ མ་ ཤེས་ ན་ རྩ་ མི་ ཤེས་ ལ །"
msgstr "Because of that without knowing the body one cannot know channels."

msgctxt "6efe448f98f94ff59494c06462998b5b"
msgid "དེ་ མ་ ཤེས་ ན་ རྟེན་ ཐིག་ལེ་ མི་ ཤེས །"
msgstr "Without knowing channels one cannot know the base, the vital essence."

msgctxt "31cbee333b9547f8b4ca61ae38bfa168"
msgid "དེ་ མི་ ཤེས་པ་␣ས་ སེམས་ ཀྱི་ རྒྱལ་པོ་␣འི་ བཞུགས་ ས་ མི་ ཤེས་ སོ །"
msgstr ""
"Without knowing that one cannot know the place of residence of “the king of "
"the mind”."

msgctxt "418cd62166954d4a94ab63157b012390"
msgid "ལུས་ ཀྱི་ གནས་ལུགས་ ཤེས་ ན་ སེམས་ ཀྱི་ རྒྱལ་པོ་␣འི་ བཞུགས་ ས་ ཤེས །"
msgstr ""
"By knowing the actuality of the body one can know the place of residence of "
"“the king of the mind”."

msgctxt "f103e4c0cdeb43b08fd8328522d1c39c"
msgid "དེ་ ཤེས་པ་␣ས་ གནད་ དུ་ སྒོམ་ ཤེས་པ་␣ར་ འགྱུར་ རོ །"
msgstr "By knowing that one will know the important points of meditation."

msgctxt "ca164523c4ed4987b49f29cb4351f3a7"
msgid "དེ་ མ་ ཤེས་ ན་ བསྒོམས་ ཀྱང་ ཡེ་ཤེས་ མི་ འཆར་ ཏེ །"
msgstr "By not knowing that even by meditating wisdom won’t appear."

msgctxt "eb7246460d5e4828b6f673c45ffe2d88"
msgid ""
"རྩ་ རྣམས་ ནི་ སུམ་ཅུ་རྩ་གཉིས་ ཏེ །  བྱང་ཆུབ་ ཀྱི་ སེམས་ སུམ་ཅུ་རྩ་གཉིས་ "
"འབབ་པ །  བདེ་བ་ ཆེན་པོ་␣འི་ གནས་ སུ་ འཛག་པ་␣འོ །"
msgstr ""
"The number of main channels is thirty-two and there are thirty-two "
"Bodhisattvas that reside in a state of great bliss."

msgctxt "99f682b1db9940089337752ded8385cc"
msgid ""
"དེ་ རྣམས་ ཀྱི་ ནང་ ནས་ རྩ་ རྣམ་པ་ གསུམ་ ནི་ གཙོ་ མོ་ སྟེ །  རྐྱང་མ་ དང་ །  "
"རོ་ མ་ དང་ །  ཀུན་ འད་␣ར་ མ་␣འོ །"
msgstr ""
"Out of these thirty-two channels the three main ones are lalana, rasana, and"
" avadhuti."

msgctxt "1f0759136063444d901d851abdd48ffa"
msgid "རྐྱང་མ་ ཤེས་རབ་ རང་བཞིན་ ཏེ །"
msgstr "Lalana - Lalana - in the nature of wisdom,"

msgctxt "8acfde67a9c74aad8a3b08f99a531061"
msgid "རོ་ མ་ ཐབས་ ཀྱི་ ཡང་དག་ གནས །"
msgstr "Rasana abides in an extreme purity of the method,"

msgctxt "530bee71fbca4c18a87f7aff0ea02814"
msgid "ཀུན་ འད་␣ར་ མ་ ནི་ དབུས་ གནས་པ །"
msgstr "Avadhuti, which is located in the center,"

msgctxt "6f409de48f774736aed7b6db4c387e25"
msgid "གཟུང་ དང་ འཛིན་པ་ རྣམ་པ་␣ར་ སྤངས །"
msgstr "Abandons grasped and grasping."
